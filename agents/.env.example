# Copy to agents/.env
# Leave GEMINI_API_KEY empty to run the deterministic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional. Unused adapters stay idle and are labelled not configured.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_IDS=
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Comma-separated. The default PIB Maharashtra feed is tried when this is unset in code.
OFFICIAL_RSS_URLS=
